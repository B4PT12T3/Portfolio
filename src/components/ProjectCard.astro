---
import { Image } from 'astro:assets';
import { projectPath, useTranslations, type Lang } from '../i18n/ui';
import type { Project } from '../lib/projects';

interface Props {
  project: Project;
  lang: Lang;
  /** Load the image eagerly (first cards visible on screen) */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
}

const { project, lang, eager = false, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const { title, cover, coverAlt, category, year } = project.data;
const Heading = headingLevel;
---

<article class="card" data-category={category}>
  <a href={projectPath(project.slug, lang)} class="link">
    <div class="media">
      <Image
        src={cover}
        alt={coverAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 76rem) 24rem, (min-width: 48rem) 45vw, 100vw"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
    <Heading class="title">{title}</Heading>
  </a>
  <p class="meta muted">{t(`cat.${category}`)}, {year}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
  }
  .link {
    text-decoration: none;
  }
  .media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--line);
  }
  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .link:hover .media :global(img) {
    transform: scale(1.025);
  }
  .title {
    font-size: var(--step-1);
    margin-top: 0.85rem;
  }
  .link:hover .title {
    color: var(--accent);
  }
  .meta {
    font-size: var(--step--1);
    margin-top: 0.2rem;
  }
</style>
