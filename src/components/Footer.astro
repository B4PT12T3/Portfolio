---
import { site } from '../config/site';
import { path, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socialLabels: Record<string, string> = {
  github: 'GitHub',
  linkedin: 'LinkedIn',
  instagram: 'Instagram',
  behance: 'Behance',
};
const socials = Object.entries(site.socials).filter(([, url]) => url);
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="available"><span class="dot" aria-hidden="true"></span>{t('footer.available')}</p>
      <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {
      socials.length > 0 && (
        <ul class="socials">
          {socials.map(([key, url]) => (
            <li>
              <a href={url} rel="me noopener" target="_blank">
                {socialLabels[key] ?? key}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="meta muted">
      © {year} {site.name}. {t('footer.rights')}
      <a href={path('legal', lang)}>{t('footer.legal')}</a>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-block: 2.5rem;
    margin-top: 3rem;
  }
  .grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    align-items: end;
  }
  @media (min-width: 48rem) {
    .grid {
      grid-template-columns: 1fr auto;
    }
    .meta {
      grid-column: 1 / -1;
    }
  }
  .available {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
  }
  .dot {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--success);
  }
  .email {
    display: inline-block;
    margin-top: 0.35rem;
    font-size: clamp(1.15rem, 0.7rem + 2.2vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .socials {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
  }
  .meta {
    font-size: var(--step--1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
</style>
